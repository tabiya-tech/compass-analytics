# Per-deployment secrets/config for a compass-analytics deployment.
#
# This is the template for the environment-variable secret that prepare.py pulls from
# Secret Manager (env-vars secret) and writes to `.env.<realm>.<deployment>` at deploy time.
# It is NEVER committed with real values — copy it, fill it in, and store it as the
# `env-vars` secret in the deployment's GCP project (see iac/README.md).
#
# Grouped by concern, mirroring backend/.env.example + frontend/.env.example.

########################################
# Backend — database
########################################
ANALYTICS_MONGODB_URI=
ANALYTICS_DATABASE_NAME=

########################################
# Backend — upstream Compass (outbound)
########################################
COMPASS_API_KEY=
COMPASS_BASE_URL=

########################################
# Auth — Google OAuth (Identity Platform / Firebase)
########################################
GCP_OAUTH_CLIENT_ID=
GCP_OAUTH_CLIENT_SECRET=

########################################
# Backend — auth (Firebase)
########################################
FIREBASE_PROJECT_ID=

########################################
# Backend — observability (Sentry)
########################################
BACKEND_ENABLE_SENTRY=false
BACKEND_SENTRY_DSN=/.*/
# JSON, e.g. {"tracesSampleRate": 0.2, "enableLogs": false, "logLevel": "info", "eventLevel": "error"}
BACKEND_SENTRY_CONFIG=/.*/

########################################
# Frontend — app identity / branding (baked into JS bundle at deploy time)
########################################
VITE_APP_NAME=
VITE_BROWSER_TAB_TITLE=
VITE_META_DESCRIPTION=
VITE_LOGO_URL=/.*/
VITE_LOGO_INVERSE_URL=/.*/
VITE_FAVICON_URL=/.*/

########################################
# Frontend — theme (leave empty to use defaults from index.css)
########################################
VITE_THEME_TABIYA_BLUE=/.*/
VITE_THEME_TABIYA_GREEN=/.*/
VITE_THEME_LIGHT_GREEN=/.*/
VITE_THEME_TABIYA_GREY=/.*/
VITE_THEME_GREEN_2=/.*/
VITE_THEME_GREEN_3=/.*/
VITE_THEME_GREY_TEXT=/.*/
VITE_THEME_FONT_PRIMARY=/.*/
VITE_THEME_FONT_MONO=/.*/

########################################
# Frontend — auth (Firebase)
# Note: VITE_FIREBASE_API_KEY, VITE_FIREBASE_AUTH_DOMAIN, and VITE_FIREBASE_PROJECT_ID
# are injected automatically from stack outputs at deploy time (prepare_frontend.py reads
# the auth and environment stacks). Do not set them here — they will be ignored.
########################################

########################################
# Frontend — observability (Sentry)
########################################
VITE_SENTRY_ENABLED=/.*/
VITE_SENTRY_DSN=/.*/
VITE_SENTRY_TRACES_SAMPLE_RATE=/.*/
VITE_TARGET_ENVIRONMENT_NAME=/.*/

########################################
# Deploy-time (set by scripts/prepare.py — do not set by hand)
########################################
# TARGET_GIT_BRANCH_NAME=
# TARGET_GIT_SHA=
# DEPLOYMENT_RUN_NUMBER=
