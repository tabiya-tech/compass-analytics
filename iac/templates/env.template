# Per-deployment secrets/config for a compass-analytics deployment.
#
# This is the template for the environment-variable secret that prepare.py pulls from
# Secret Manager (env-vars secret) and writes to `.env.<realm>.<deployment>` at deploy time.
# It is NEVER committed with real values — copy it, fill it in, and store it as the
# `env-vars` secret in the deployment's GCP project (see iac/README.md).
#
# Grouped by concern, mirroring backend/.env.example + frontend/.env.example.

########################################
# Backend — database
########################################
ANALYTICS_MONGODB_URI=
ANALYTICS_DATABASE_NAME=

########################################
# Backend — upstream Compass (outbound)
########################################
COMPASS_API_KEY=
COMPASS_BASE_URL=

########################################
# Backend — auth (Firebase)
########################################
FIREBASE_PROJECT_ID=

########################################
# Backend — observability (Sentry)
########################################
BACKEND_ENABLE_SENTRY=false
BACKEND_SENTRY_DSN=
# JSON, e.g. {"tracesSampleRate": 0.2, "enableLogs": false, "logLevel": "info", "eventLevel": "error"}
BACKEND_SENTRY_CONFIG={}

########################################
# Frontend — auth (Firebase)
########################################
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

########################################
# Frontend — observability (Sentry)
########################################
FRONTEND_ENABLE_SENTRY=false
FRONTEND_SENTRY_DSN=
FRONTEND_SENTRY_TRACES_SAMPLE_RATE=1.0

########################################
# Deploy-time (set by scripts/prepare.py — do not set by hand)
########################################
# TARGET_GIT_BRANCH_NAME=
# TARGET_GIT_SHA=
# DEPLOYMENT_RUN_NUMBER=
