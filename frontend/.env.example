# Copy this file to .env.local (git-ignored) and fill in real values.
#
# Vite only exposes variables prefixed with VITE_ to the client bundle
# (via import.meta.env.*). All values here are baked into the JS bundle at
# build time — there is no runtime config fetch.

# ---- Mock Service Worker ----
# Set to "true" to intercept API calls with MSW handlers during local dev.
# Leave unset (or false) when running against a real backend.
VITE_MSW=false

# ---- App identity ----
VITE_APP_NAME=Compass Analytics
VITE_BROWSER_TAB_TITLE=Compass Analytics
VITE_META_DESCRIPTION=Central analytics dashboard for Tabiya's products, giving reach, engagement, and outcome data to implementers and funders.

# ---- Assets (absolute URL or root-relative path served from the same bucket) ----
VITE_LOGO_URL=/logos/tabiya-logo-color.svg
VITE_LOGO_INVERSE_URL=/logos/tabiya-logo-white.svg
VITE_FAVICON_URL=/logos/tabiya-logo-color.svg

# ---- Theme (CSS custom properties; leave unset to use the defaults in index.css) ----
VITE_THEME_TABIYA_BLUE=#002147
VITE_THEME_TABIYA_GREEN=#00ff91
VITE_THEME_LIGHT_GREEN=#e4f8e2
VITE_THEME_TABIYA_GREY=#f8f5f0
VITE_THEME_GREEN_2=#26b87d
VITE_THEME_GREEN_3=#247066
VITE_THEME_GREY_TEXT=#757575
VITE_THEME_FONT_PRIMARY='DM Sans', system-ui, -apple-system, sans-serif
VITE_THEME_FONT_MONO='DM Mono', 'SF Mono', ui-monospace, monospace

# ---- Firebase Auth ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# ---- Observability ----
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
VITE_TARGET_ENVIRONMENT_NAME=local
