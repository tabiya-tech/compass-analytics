# Copy this file to .env and fill in real values for local development.

# ---- App / environment identity & CORS ----
LOG_CONFIG_FILE=logging.cfg.dev.yaml
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://0.0.0.0:8080
TARGET_ENVIRONMENT_TYPE=local
TARGET_ENVIRONMENT_NAME=local

# ---- Database ----
ANALYTICS_MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>/?retryWrites=true&w=majority&appName=CompassAnalytics-Dev
ANALYTICS_DATABASE_NAME=compass-analytics-dev

# ---- Observability ----
BACKEND_ENABLE_SENTRY=False
BACKEND_SENTRY_DSN=
BACKEND_SENTRY_CONFIG={"tracesSampleRate": 0.2, "enableLogs": false, "logLevel": "info", "eventLevel": "error"}
